{
  "name": "origo",
  "private": true,
  "description": "Origo: an on-chain registry of visual fingerprints for photos that survives re-encoding, built on Monad.",
  "license": "MIT",
  "author": "Wangsit Nursyahada",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:contracts",
    "test:contracts": "cd contracts && forge test",
    "dev": "pnpm --filter @origo/web dev",
    "check:dashes": "python3 scripts/check-dashes.py"
  }
}
